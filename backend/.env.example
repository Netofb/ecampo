# Database Configuration
# Para produção (Render), use DATABASE_URL
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# Para desenvolvimento local, use variáveis individuais
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha
DB_NAME=ecampo

# JWT Secret (use uma string aleatória longa e segura)
JWT_SECRET=sua_chave_secreta_jwt_aqui_minimo_32_caracteres

# Server Configuration
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# Bcrypt Rounds (10-12 recomendado para produção)
BCRYPT_ROUNDS=10
